# Set at least one provider. Each configured provider shows up on the /configure page.

# LibreTranslate (free, self-hosted). compose.yaml sets this for you.
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Any OpenAI-compatible API (OpenAI, OpenRouter, Gemini, Groq, Ollama, ...). OPENAI_MODEL is required.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Subtitle addons to read English subtitles from, in your Stremio addon order.
# SUBTITLE_ADDONS=https://opensubtitles-v3.strem.io

# PORT=7000
# PUBLIC_URL=https://subtitles.example.com
# CACHE_DIR=./cache
# PREFETCH=true
# TRANSLATE_CONCURRENCY=4
